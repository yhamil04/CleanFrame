{
  "name": "cleanframe",
  "version": "0.6.1",
  "private": true,
  "description": "CleanFrame for LG webOS: a quiet, remote-first home screen. A port of Nathan Clark's CleanFrame for Samsung The Frame.",
  "scripts": {
    "dev": "python3 scripts/preview.py",
    "dev:public": "python3 scripts/preview.py --public-fonts",
    "check": "node --check app/main.js && node --check app/device.js && node scripts/check-es5.mjs && python3 scripts/check.py",
    "check:browser": "node scripts/check-browser.mjs",
    "check:public": "python3 scripts/check-public.py",
    "webos:stage": "python3 scripts/webos.py stage",
    "webos:package": "python3 scripts/webos.py package",
    "webos:install": "python3 scripts/webos.py install",
    "webos:launch": "python3 scripts/webos.py launch",
    "webos:inspect": "python3 scripts/webos.py inspect",
    "wallpapers:add": "python3 scripts/add-wallpapers.py"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "playwright": "1.64.1"
  },
  "license": "MIT"
}
